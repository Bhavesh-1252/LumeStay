<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Account</title>
</head>

<body style="margin:0;padding:0;background:#F7F7F7;font-family:Arial,Helvetica,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0"
          style="background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td align="center" style="background:#FF385C;padding:36px;">
              <h1 style="margin:0;color:#FFFFFF;font-size:32px;font-weight:bold;">
                Lumestay
              </h1>
              <p style="margin:8px 0 0;color:#FFE7ED;font-size:15px;">
                One step away from your next stay
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:40px;">

              <h2 style="margin:0 0 16px;color:#222222;font-size:26px;">
                Welcome to Lumestay!
              </h2>

              <p style="margin:0 0 20px;color:#555555;font-size:16px;line-height:1.7;">
                Thanks for creating your account. To keep your account secure,
                please verify your email address by using this OTP.
              </p>

              <!-- CTA Button -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin:32px 0;">
                <tr>
                  <td align="center">
                    <span
                      style="display:inline-block;background:#FF385C;color:#FFFFFF;text-decoration:none;font-size:18px;font-weight:bold;padding:16px 36px;border-radius:999px;">
                      <%= otp %>
                    </span>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 16px;color:#555555;font-size:15px;line-height:1.6;">
                This OTP will expire in <strong>30 minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background:#FAFAFA;border-top:1px solid #EEEEEE;padding:24px;">
              <p style="margin:0;color:#999999;font-size:13px;">
                If you didn't create a Lumestay account, you can safely ignore this email.
              </p>
              <p style="margin:10px 0 0;color:#999999;font-size:13px;">
                © 2026 Lumestay. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>