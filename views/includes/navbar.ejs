<style>
    .search-btn {
        background-color: #fe424d;
        color: white;
    }

    .search-btn i {
        display: inline;
    }

    .search-btn:hover {
        background-color: #fe424d;
        color: white;
    }

    .search-input {
        font-size: 0.9rem;
        padding: 0.6rem 1rem;
        /* max-width: ; */
        /* text-align: center; */
    }
</style>

