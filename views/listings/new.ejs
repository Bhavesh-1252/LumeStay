<% layout("/layouts/boilerplate") %>

    <body>

        <div class="row mt-3">            
            <div class="col-8 offset-2">
                <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
                    <h3>Create a New Listing</h3>
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" placeholder="Add a catchy title" class="form-control" name="listing[title]" required>
                        <div class="valid-feedback">Title is perfect</div>
                        <div class="invalid-feedback">Require a catchy title </div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" placeholder="Write description..." class="form-control" name="listing[description]" required></textarea>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Add Image</label>
                        <input type="file" id="image" class="form-control" name="listing[image]" required>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input type="number" placeholder="e.g. ₹1,200" id="price" class="form-control" name="listing[price]" required>
                            <div class="invalid-feedback">Price should be valid</div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="location" class="form-label">Location</label>
                            <input type="text" placeholder="e.g. Jaipur, Mumbai" id="location" class="form-control" name="listing[location]" required>
                            <div class="invalid-feedback">Location should be valid</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" placeholder="e.g. India" id="country" class="form-control" name="listing[country]" required>
                        <div class="invalid-feedback">Country should be valid</div>
                    </div>
                    <br>
                    <button class="btn btn-dark add-btn mb-5">Save</button>
                </form>
            </div>
        </div>
    </body>