<% layout("/layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-3">
      <h3>
        <%= list.title %>
      </h3>
    </div>

    <div class="card listing-card col-6 offset-3">
      <img src="<%= list.image %>" class="card-img-top show-img" alt="<%= list.title %>" />
      <div class="card-body">
        <p class="card-text">
          <%= list.description %> <br />
            &#8377; <%= list.price.toLocaleString("en-IN") %> <br />
              <%= list.location %> <br />
                <%= list.country %>
        </p>
      </div>
    </div>

    <div class="btns offset-3">
      <a href="/listings/<%= list._id%>/edit" class="btn btn-dark add-btn">Edit</a>
      <form action="/listings/<%= list._id %>?_method=DELETE" method="post" class="">
        <button class="btn btn-dark add-btn offset-2">Delete</button>
      </form>
    </div>

    <div class="col-8 offset-3">
      <hr />
      <h4>Leave a Review</h4>

      <form action="/listings/<%= list._id %>/reviews" method="post" novalidate class="needs-validation mb-3">
        <div class="my-3">
          <label class="form-label" for="rating">Rating</label>
          <input class="form-range" type="range" name="review[rating]" id="rating" min="1" max="5" />
        </div>
        <div class="my-3">
          <label class="form-label" for="comment">Comment</label>
          <textarea class="form-control" name="review[comment]" id="comment" rows="6" cols="50" required></textarea>
          <div class="invalid-feedback">Write a comment!</div>
        </div>

        <button class="btn btn-outline-dark">Save</button>
      </form>

      <% if(list.reviews && list.reviews.length) { %>
        <hr />
        <p><b>All Reviews</b></p>

        <div class="row">
          <% for(let review of list.reviews) { %>
            <div class="card col-5 ms-3 mb-3">
              <div class="card-body">
                <h5 class="card-title mt-3">John Doe</h5>
                <p class="card-text">
                  <%= review.comment %>
                </p>
                <p class="card-text">
                  <%= review.rating %>⭐
                </p>
                <form action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3"
                  method="post">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>
  </div>